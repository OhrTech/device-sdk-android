<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="OhrTech SDK sample"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Managed configuration (OhrConfig): what the fleet may set for this app. -->
        <meta-data android:name="android.content.APP_RESTRICTIONS" android:resource="@xml/app_restrictions" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Push: only the OhrTech Agent holds RECEIVE_PUSH, so nothing else can bind it. -->
        <service
            android:name=".SamplePushService"
            android:exported="true"
            android:permission="net.ohrtech.device.permission.RECEIVE_PUSH">
            <intent-filter>
                <action android:name="net.ohrtech.device.action.PUSH" />
            </intent-filter>
        </service>
    </application>
</manifest>
